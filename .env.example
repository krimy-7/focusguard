# ============================================================
# FocusGuard — root environment reference
# Copy to .env and adjust. These feed the mobile app's API
# layer and mirror the values in backend/.env.example.
# ============================================================

# Where the FastAPI backend lives.
# - Local dev:   http://localhost:8000
# - Demo/ngrok:  https://<your-sub>.ngrok.io
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional: run the app on bundled demo data (1 = on).
# EXPO_PUBLIC_DEMO_MODE=0

# Chrome extension backend URL (kept in sync with extension/config.js).
EXTENSION_BACKEND_URL=http://localhost:8000
