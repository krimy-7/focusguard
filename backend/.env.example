# ---- Server ----
DEBUG=false

# ---- Database ----
# Local dev/tests: SQLite file (default). Create/upgrade the schema with: alembic upgrade head
# Never leave this line as an empty `DATABASE_URL=`: empty counts as set and overrides the default.
# An old hackathon Postgres already has a `contexts` table: drop it / use a fresh database first.
# Production: Supabase Postgres. Use the SESSION pooler (port 5432) or the direct connection URL;
# the transaction pooler (port 6543) breaks psycopg's prepared statements.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./focusguard.db

# ---- Supabase Auth ----
# Project URL, used only by DELETE /api/me to remove the sign-in (admin deleteUser).
SUPABASE_URL=
# Access tokens are verified locally against these (ES256, aud=authenticated).
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<ref>.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
# SERVER-ONLY secret (Cloud Run secret in prod). Never put it in the extension or the dashboard.
# Leave empty locally: DELETE /api/me then deletes app data only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- CORS ----
# Comma-separated dashboard origins (Expo web dev server is http://localhost:8081).
DASHBOARD_ORIGINS=http://localhost:8081
# Fixed by the manifest "key" (index R39). Public, safe to commit. Allowed as chrome-extension://<id>, exact match only.
EXTENSION_ID=jkkgdjhaoomnjkblodmmjoikglknmifi
