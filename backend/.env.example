# ---- Server ----
APP_NAME=FocusGuard
APP_ENV=development
DEBUG=true

# ---- Database ----
# Postgres (used by the extension + mobile backend sync)
# Leave empty to fall back to a local SQLite file (backend/focusguard.db).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/focusguard

# ---- AI Provider ----
# One of: deepseek | openai | claude | gemini | ollama | mock
# If the chosen provider has no API key configured (or is unreachable),
# the service automatically falls back to local mock data.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

DEEPSEEK_API_KEY=
OPENAI_API_KEY_FIRST=
OPENAI_API_KEY_SECOND=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUDIO_MODEL=whisper-1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- CORS ----
# Comma-separated list of origins allowed to talk to the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
