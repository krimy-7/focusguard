{
  "manifest_version": 3,
  "key": "",
  "name": "FocusGuard AI",
  "version": "2.0.0",
  "description": "Privacy-first focus coach. Notices drift from the task you chose, gives you grace, and nudges you back gently.",
  "minimum_chrome_version": "127",
  "permissions": ["tabs", "storage", "alarms", "idle", "notifications", "scripting", "tabGroups", "declarativeNetRequestWithHostAccess", "identity"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FocusGuard AI",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
